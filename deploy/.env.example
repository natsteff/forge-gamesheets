# OPTIONAL: defaults are in compose.yml. Do not set build identity here.
# Copy beside the downloaded compose.yml as .env, or set variables in your GUI.
FORGE_GAMESHEETS_IMAGE_TAG=main
FORGE_GAMESHEETS_DATA_PATH=./data
FORGE_GAMESHEETS_LIBRARY_PATH=./library
FORGE_GAMESHEETS_BIND_ADDRESS=127.0.0.1
FORGE_GAMESHEETS_PORT=8000
FORGE_GAMESHEETS_MODE=full
# Choose owner (accounts; HTTPS for remote setup/sign-in) or trusted (open LAN).
# trusted never disables accounts that have already been enabled.
FORGE_GAMESHEETS_ACCESS_MODE=owner
# Set to the exact browser URL for LAN/proxy use.
FORGE_GAMESHEETS_BASE_URL=
FORGE_GAMESHEETS_ALLOWED_HOSTS=
FORGE_GAMESHEETS_FORWARDED_ALLOW_IPS=127.0.0.1
# Optional private BGG application token; never publish it.
FORGE_GAMESHEETS_BGG_API_TOKEN=
