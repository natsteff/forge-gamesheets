              ],
              "properties": {
                "strings": {
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 8
                },
                "line_spacing_pt": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 12,
                  "multipleOf": 0.25
                },
                "group_gap_pt": {
                  "type": "number",
                  "minimum": 12,
                  "maximum": 72,
                  "multipleOf": 0.25
                },
                "string_labels": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 8,
