              ],
              "properties": {
                "spacing_pt": {
                  "type": "number",
                  "minimum": 7,
                  "maximum": 36,
                  "multipleOf": 0.25
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
