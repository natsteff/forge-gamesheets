{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge-gamesheets:schema:fgs:1.0",
  "title": "FGS v1 document",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "id", "title", "page", "theme", "rows"],
  "properties": {
    "format": {"const": "forge-gamesheets"},
    "format_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "page": {"$ref": "#/$defs/page"},
    "theme": {"$ref": "#/$defs/theme"},
    "rows": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/row"}},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "extensions": {"type": "object", "maxProperties": 32, "propertyNames": {"pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"}},
    "page": {"type": "object", "additionalProperties": false, "required": ["size", "orientation"], "properties": {"size": {"enum": ["letter", "a4"]}, "orientation": {"enum": ["portrait", "landscape"]}, "extensions": {"$ref": "#/$defs/extensions"}}},
    "theme": {"type": "object", "additionalProperties": false, "required": ["accent"], "properties": {"accent": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}, "extensions": {"$ref": "#/$defs/extensions"}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["id", "blocks"], "properties": {"id": {"$ref": "#/$defs/id"}, "blocks": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"oneOf": [{"$ref": "#/$defs/header"}, {"$ref": "#/$defs/score"}, {"$ref": "#/$defs/reference"}, {"$ref": "#/$defs/checklist"}, {"$ref": "#/$defs/notes"}]}}, "extensions": {"$ref": "#/$defs/extensions"}}},
    "header": {"type": "object", "additionalProperties": false, "required": ["id", "type", "title", "subtitle"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "header"}, "title": {"type": "string", "maxLength": 160}, "subtitle": {"type": "string", "maxLength": 240}, "extensions": {"$ref": "#/$defs/extensions"}}},
    "score": {"type": "object", "additionalProperties": false, "required": ["id", "type", "title", "players", "score_rows", "show_total", "total_label"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "score_table"}, "title": {"type": "string", "minLength": 1, "maxLength": 160}, "players": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 40}}, "score_rows": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 80}}, "show_total": {"type": "boolean"}, "total_label": {"type": "string", "minLength": 1, "maxLength": 80}, "extensions": {"$ref": "#/$defs/extensions"}}},
    "items": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["id", "type", "title", "items"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "reference"}, "title": {"type": "string", "minLength": 1, "maxLength": 160}, "items": {"$ref": "#/$defs/items"}, "extensions": {"$ref": "#/$defs/extensions"}}},
    "checklist": {"type": "object", "additionalProperties": false, "required": ["id", "type", "title", "items"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "checklist"}, "title": {"type": "string", "minLength": 1, "maxLength": 160}, "items": {"$ref": "#/$defs/items"}, "extensions": {"$ref": "#/$defs/extensions"}}},
    "notes": {"type": "object", "additionalProperties": false, "required": ["id", "type", "title", "lines"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "notes"}, "title": {"type": "string", "minLength": 1, "maxLength": 160}, "lines": {"type": "integer", "minimum": 1, "maximum": 20}, "extensions": {"$ref": "#/$defs/extensions"}}}
  }
}
