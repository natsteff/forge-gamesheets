# Copy this file to .env to override the safe local Compose defaults.
# Do not expose Forge directly to the Internet; it has no built-in authentication.
FORGE_GAMESHEETS_BIND_ADDRESS=127.0.0.1
FORGE_GAMESHEETS_PORT=8000
FORGE_GAMESHEETS_BASE_URL=
FORGE_GAMESHEETS_DATA_PATH=./data
FORGE_GAMESHEETS_LIBRARY_PATH=./library

# Published image channel. Use main for current development builds or a release
# tag for a fixed release after versioned images are available.
FORGE_GAMESHEETS_IMAGE_TAG=main

# Optional BoardGameGeek application token. BGG features remain off when empty.
# Register the application and create its token at https://boardgamegeek.com/applications
FORGE_GAMESHEETS_BGG_API_TOKEN=

# Optional build identity displayed in Settings and /health.
FORGE_GAMESHEETS_VERSION=development
FORGE_GAMESHEETS_REVISION=
FORGE_GAMESHEETS_BUILD_DATE=
